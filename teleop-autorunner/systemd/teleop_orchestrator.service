[Unit]
Description=G1 Teleoperation NATS orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unitree
Group=unitree
EnvironmentFile=-/etc/robot/robot.env
WorkingDirectory=/opt/teleop_autorunner
ExecStart=/opt/teleop_autorunner/scripts/start_orchestrator.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
